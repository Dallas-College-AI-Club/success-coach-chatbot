# Copy to .env and fill in from your Neon project (console.neon.tech → Connect).
# Never commit .env or real credentials. See README.md → Database.

# Pooled connection string (host contains "-pooler").
# Used by the Next.js app (TypeScript) for all reads/writes at request time.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct (unpooled) connection string.
# Used by Python: Alembic migrations and bulk data ingest.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Data-pipeline configuration (embedding provider, chunking) lives separately
# in apps/data/.env — see apps/data/.env.example.
