# =========================================================================
# Success Coach Chatbot: Environment Configuration Template (.env.example)
# Copy this file to '.env' (in the root) or '.env.local' (in apps/frontend/)
# and fill in your actual credentials.
# =========================================================================

# 1. AI & LLM Routing Configurations
# Retrieve this key by signing up on https://openrouter.ai/
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# 2. Database & Vector Store Configurations
# Connection endpoint for PostgreSQL (Neon Serverless Database)
NEON_API_KEY="your_neon_api_rest_endpoint_here"

# Pinecone vector database credentials (if applicable)
PINECONE_API_KEY="your_pinecone_api_key_here"

# Local vector database storage path for ChromaDB testing
CHROMA_DB_PATH="apps/data/chroma_db"
CHROMA_COLLECTION_NAME="dallas_college_kb"

# 3. Third-Party Integrations
# Vercel developer token for hosting deployment control
VERCEL_API_KEY="your_vercel_api_key_here"

# Cloudflare account configurations for edge workers / CDNs
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"
CLOUDFLARE_API_KEY="your_cloudflare_api_key_here"

# GitHub token for repository tasks and automated actions
GITHUB_TOKEN="your_github_personal_access_token_here"
