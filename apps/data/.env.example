# Data pipeline configuration (issues #34/#35) — copy to .env, never commit .env.
# Database contract: docs/DATABASE_ARCHITECTURE.md §6.4

# Direct (unpooled) Neon connection string — migrations and bulk ingest only (Primary).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Pooled Neon connection string (Optional fallback).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Alternative Neon connection string (Optional fallback).
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Local PostgreSQL connection parameters (Optional fallback if no connection URL is provided).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=chatbot_test

# Extraction (see apps/data/EXTRACTION_MANUAL.md §1).
# Keys are PER PERSON — every club member uses their own; never share or commit.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# provider:model for the extraction engine (anthropic:* | lmstudio:* | ollama:* | openrouter:*)
EXTRACTOR=anthropic:claude-sonnet-5
# absolute path to the raw scraped corpus (outside the repo)
RAW_ROOT=
# used only by run_catalog.ps1 as its output root; the python CLIs take --out flags
FACTS_OUT=

# Embeddings need no key: dallasai/pipeline/embed_rows.py runs the frontend's
# local MiniLM encoder (384 dims) through Node — see REPRODUCE.md.

# --- $0 local-model path (only when EXTRACTOR=ollama:... or lmstudio:...) ---
# Ollama endpoint and context window. The code raises rather than let a prompt
# truncate silently, so raise NUM_CTX if it complains.
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=
# LM Studio (and any OpenAI-compatible endpoint). Defaults:
#   lmstudio -> http://localhost:1234/v1, key "lm-studio"
#   openrouter -> https://openrouter.ai/api/v1, key from OPENROUTER_API_KEY
LLM_BASE_URL=
LLM_API_KEY=
