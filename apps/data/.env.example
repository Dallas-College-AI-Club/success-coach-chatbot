# Copy to `.env` and fill in real values. NEVER commit `.env` (git-ignored).
# This is the ONLY file in the repo allowed to show a connection-string shape —
# CI fails the build if postgres:// or postgresql:// appears anywhere else
# outside docs/ (CLAUDE_CODE_BRIEF step 11).

# --- Database (db/client.py + db/client.ts read these) ----------------------
# Neon: dashboard -> your project -> "Connect" -> copy the connection string.
# Any vanilla Postgres works the same (ADR-008).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Alternative to DATABASE_URL: the standard libpq variables (CI uses these).
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=chatbot_dev

# Pool sizing (optional)
# DB_POOL_MIN=1
# DB_POOL_MAX=5

# --- Extraction (pipeline/extract.py) ---------------------------------------
# provider:model — the ONLY thing that changes when swapping models (ADR-002).
EXTRACTOR="anthropic:claude-sonnet-4-6"
# EXTRACTOR="ollama:qwen2.5-14b"        # free local model, zero schema changes
# ANTHROPIC_API_KEY="sk-ant-..."        # only for EXTRACTOR=anthropic:* via API
# OLLAMA_HOST="http://localhost:11434"  # only for EXTRACTOR=ollama:*

# --- Embeddings (db/optional_pgvector.sql — OPTIONAL Module 3) --------------
# Dimension and metric are a MATCHED PAIR with this model (brief step 12):
# nomic-embed-text = 768 (the pinned default); OpenAI-style models = 1536
# (edit the vector() dimension in db/optional_pgvector.sql when changing).
EMBED_MODEL="nomic-embed-text"

# --- Tests -------------------------------------------------------------------
# pytest DROPS AND REBUILDS the public schema. It refuses databases whose name
# doesn't end in _test unless you explicitly set (uncomment only on purpose,
# pointing at a disposable database):
# ALLOW_TEST_DB_RESET=true
