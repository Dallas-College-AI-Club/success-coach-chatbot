# Data pipeline configuration (issues #34/#35) — copy to .env, never commit .env.
# Database contract: docs/DATABASE_ARCHITECTURE.md §6.4

# Direct (unpooled) Neon connection string — migrations and bulk ingest only.
# (The pooled DATABASE_URL is the Next.js app's; the pipeline never needs it.)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Embedding engine — provider is a pending TEAM DECISION (docs/DATABASE_ARCHITECTURE.md §9).
# Hard constraint either way: 768-dim cosine-space vectors, and the SAME model must be
# reachable at query time from the Next.js API route (§3). Example configurations:
#   Hosted free tier:   EMBED_PROVIDER=gemini    EMBED_MODEL=gemini-embedding-001
#   Local (LM Studio):  EMBED_PROVIDER=lmstudio  EMBED_MODEL=nomic-embed-text  EMBED_BASE_URL=http://localhost:1234/v1
EMBED_PROVIDER=
EMBED_MODEL=
EMBED_DIMENSIONS=768
EMBED_API_KEY=
EMBED_BASE_URL=

# Chunking (issue #35)
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_PCT=15

# Local Chroma Vector Database Configuration
CHROMA_DB_PATH=apps/data/chroma_db
CHROMA_COLLECTION_NAME=dallas_college_kb
