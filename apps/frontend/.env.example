# Success Coach Chatbot — frontend environment (copy to .env.local, never commit .env*)
#
# Local dev:    cp .env.example .env.local  and fill in values.
# Production:   set the same variables in Vercel → Project → Settings →
#               Environment Variables (the deployed app reads ONLY those).
#
# Key policy (club rule): API keys are PERSONAL — every member creates their
# own and never shares it (chat, commits, screenshots, shared drives). Use a
# SEPARATE key from the data pipeline's (apps/data/.env) too, so each side has
# its own spend limit and usage graph. Production uses its own key in Vercel.


# ── Required ────────────────────────────────────────────────────────────────
# BASE URL for OpenAI compatible endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1
# Paid model selected for the demo; requires OpenRouter credits.
LLM_MODEL=openai/gpt-4.1-mini

# ── Required ────────────────────────────────────────────────────────────────
# OpenRouter — the LLM gateway for chat (app/api/chat/route.ts).
# Retrieval uses local all-MiniLM-L6-v2 embeddings (384 dimensions), matching
# the vectors loaded into knowledge_entry; it does not use this API key.
# Create a key at https://openrouter.ai/settings/keys (set a spend limit).

OPENROUTER_API_KEY=

# ── Database (required for catalog, schedules and retrieval) ───────────────
# Neon POOLED connection string (host contains "-pooler") — serverless HTTP
# queries from API routes via @neondatabase/serverless (lib/client.ts).
# The direct/unpooled string belongs to the Python pipeline, not the app.
DATABASE_URL=

# ── Optional ────────────────────────────────────────────────────────────────
# /api/chat rejects cross-origin browser POSTs so another site cannot spend the
# club's OpenRouter quota. The request's own host is ALWAYS allowed, so
# localhost and preview deployments need no configuration and this can stay
# blank. Set it (e.g. https://success-coach.vercel.app) only if the public
# origin differs from the Host the app receives — behind a proxy that rewrites
# Host, otherwise every browser POST would 403.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Build-time only ─────────────────────────────────────────────────────────
# Path to the catalog program index JSON — only used by the onboarding
# program-picker regeneration script (features/onboarding/generate-programs.mjs);
# the raw catalog lives outside the repo.
PROGRAM_INDEX=
