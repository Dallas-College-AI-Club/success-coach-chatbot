{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "facts-section-v2",
  "title": "facts-section-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "section_number",
    "meetings",
    "materials_links",
    "confidence"
  ],
  "properties": {
    "section_number": {
      "type": "string"
    },
    "instructor": {
      "type": [
        "string",
        "null"
      ]
    },
    "instructor_slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "modality": {
      "enum": [
        "online",
        "in_person",
        "hybrid",
        null
      ]
    },
    "campus": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "meetings": {
      "type": "array",
      "$comment": "Empty means no parsed meeting times. Preserve meeting_info_raw; never infer modality or asynchrony from this array.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "days",
          "start_time",
          "end_time"
        ],
        "properties": {
          "type": {
            "enum": [
              "lecture",
              "lab",
              "other"
            ]
          },
          "days": {
            "type": "string"
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          },
          "building": {
            "type": [
              "string",
              "null"
            ]
          },
          "room": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "meeting_info_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "coreq_section_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "credit_hours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "materials_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "component": {
            "enum": [
              "lecture",
              "lab",
              null
            ]
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "inclusive_access": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "syllabus": {
      "type": [
        "object",
        "null"
      ],
      "$comment": "the offering's syllabus facts (a full facts-syllabus-v1 object), EMBEDDED here so a section and its syllabus are ONE row. Present only on the offering's REPRESENTATIVE section (the one whose syllabus was fetched); sibling sections of the same professor+course+modality carry syllabus_ref instead. Exactly one of syllabus / syllabus_ref is non-null once a syllabus exists; both null = no syllabus fetched yet (staleness fallback fires)."
    },
    "syllabus_source_url": {
      "type": [
        "string",
        "null"
      ],
      "$comment": "the Concourse view_syllabus URL the embedded syllabus came from - REQUIRED for DP-013 citations, since this row's own source_url is the schedule CSV. Non-null whenever syllabus is non-null."
    },
    "syllabus_ref": {
      "type": [
        "string",
        "null"
      ],
      "$comment": "source_url of the sibling section row that carries facts.syllabus for this offering (one point-read away). Serving a sibling's syllabus always renders the DP-041 provenance label ('based on the syllabus for section N')."
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "$comment": "Backward-compatible section facts plus preserved source meeting text. Empty meetings means no parsed clock times, not asynchronous or online."
}
